# 复制为 .env；此文件不会覆盖进程中已经设置的环境变量。
HTTP_ADDR=127.0.0.1:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=thirteenash
DB_PASSWORD=replace-with-your-database-password
DB_NAME=thirteenash
DB_MAX_OPEN=5

# 执行 init / reset-password 时使用。服务运行期间不使用这个密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters

UPLOAD_DIR=./uploads
FRONTEND_DIR=../frontend/dist
# 上线启用 HTTPS 后设为 true；本地 HTTP 必须为 false。
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:5173
TIMEZONE=Asia/Shanghai
GITHUB_SYNC_HOUR=4
# 可选，仅后端读取。公开仓库无需 token，但匿名 API 限额较低。
GITHUB_TOKEN=
